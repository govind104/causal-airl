    "seed": 42,
    "verbose": false
  },
  "eval": {
    "test_z": null,
    "plot": true,
    "generalisation": false,
    "save_dir": "results/gridworld_baselines/",
    "gen_trajectories": true,
    "skip_value_iteration": false
  },
